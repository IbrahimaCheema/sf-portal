---
import Layout from '../layouts/Layout.astro';

const galleryPhotos = [
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_1.png", local: "/images/tmsg_photo_1.png", title: "Project Inauguration Ceremony", desc: "TMSG Trustee Mr. Salman Mubarak and Shakarganj team at inauguration." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_2.png", local: "/images/tmsg_photo_2.png", title: "Child Growth Screening", desc: "Pediatric growth assessment and MUAC tape measurement." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_3.png", local: "/images/tmsg_photo_3.png", title: "Therapeutic Food Distribution", desc: "Ready-to-use therapeutic food (RUTF) packs provided to mothers." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_4.png", local: "/images/tmsg_photo_4.png", title: "Maternal Health Guidance", desc: "Counseling sessions on infant nutrition and breastfeeding practices." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_5.png", local: "/images/tmsg_photo_5.png", title: "Muhammad Yar Rahi Dispensary", desc: "Central dispensary hub hosting the malnutrition clinic in Jhang." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_6.png", local: "/images/tmsg_photo_6.png", title: "Supplements Supply Audit", desc: "High-energy micronutrient sachets and milk supplement stock." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_7.png", local: "/images/tmsg_photo_7.png", title: "Infant Medical Examination", desc: "Free pediatric examination for severely acute malnourished (SAM) children." },
  { r2: "https://docs.sf.org.pk/images/tmsg_photo_8.png", local: "/images/tmsg_photo_8.png", title: "Community Nutrition Workshop", desc: "Educating rural mothers on balanced home diets and hygiene." }
];
---

<Layout 
  title="SF-TMSG Fight Against Malnutrition – Shakarganj Foundation"
  description="Learn about the SF-TMSG collaborative project fighting infant malnutrition and stunted growth across Jhang, Bhone, and Pakistan."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/healthcare/">Healthcare</a> <span>›</span>
        <span class="current">SF-TMSG Fight Against Malnutrition</span>
      </div>
      <h1 class="hero_page_title">SF-TMSG Fight Against Malnutrition</h1>
      <p class="hero_subtitle">A joint initiative between Shakarganj Foundation and Trust for Malnutrition & Stunted Growth (TMSG) to end child stunting.</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="malnutrition-overview-section">
    <div class="container">
      
      <div class="overview-grid">
        <div class="overview-img-box">
          <img 
            src="https://docs.sf.org.pk/images/tmsg_main_header.jpg" 
            alt="SF-TMSG Fight Against Malnutrition"
            loading="lazy"
            onerror="this.src='/images/tmsg_main_header.jpg'"
          />
        </div>
        <div class="overview-text-box">
          <span class="badge badge-accent">PROJECT LAUNCHED DEC 02, 2023</span>
          <h2 class="section-title">Eradicating Malnutrition & Stunted Growth</h2>
          <div class="title-decorator"></div>
          <p class="overview-desc">
            Shakarganj Foundation, in collaboration with <strong>TMSG (Trust for Malnutrition and Stunted Growth)</strong>, initiated the <strong>Fight Against Malnutrition Project</strong> on <strong>December 2nd, 2023</strong>.
          </p>
          <p class="overview-subtext">
            We extend our heartfelt gratitude to <strong>Mr. Najeeb Syed</strong> and <strong>Mr. Salman Mubarak</strong>, dedicated trustees at TMSG. Notably, Mr. Salman Mubarak actively participated in the inauguration event held at Shakarganj Foundation’s <em>Muhammad Yar Rahi Stationed Free Dispensary</em> at Shakarganj Limited (SML) I Jhang. Together, Shakarganj Foundation and TMSG are committed to eradicating malnutrition, beginning in Jhang and Bhone and extending our efforts throughout Pakistan.
          </p>
          
          <div class="objective-cards-grid">
            <div class="obj-card">
              <span class="obj-icon">🥛</span>
              <div>
                <h4 class="obj-title">Therapeutic Feeding</h4>
                <p class="obj-desc">Providing RUTF and specialized milk supplements to SAM infants.</p>
              </div>
            </div>
            <div class="obj-card">
              <span class="obj-icon">📏</span>
              <div>
                <h4 class="obj-title">Stunting Prevention</h4>
                <p class="obj-desc">Regular height, weight, and MUAC tracking to prevent early stunting.</p>
              </div>
            </div>
            <div class="obj-card">
              <span class="obj-icon">👶</span>
              <div>
                <h4 class="obj-title">Maternal Counseling</h4>
                <p class="obj-desc">Guidance for nursing mothers on hygiene, weaning, and home nutrition.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Photo Gallery Section -->
  <section class="malnutrition-gallery-section">
    <div class="container">
      
      <div class="section-intro">
        <span class="badge badge-primary">INDEPENDENT FIELD OUTREACH</span>
        <h2 class="section-title">Inauguration & Field Activities Gallery</h2>
        <div class="title-decorator"></div>
        <p class="section-subtitle">Highlights from the December 2023 launch ceremony and ongoing pediatric nutrition screenings in District Jhang.</p>
      </div>

      <div class="grid-4 gallery-grid">
        {galleryPhotos.map((photo) => (
          <div class="card photo-card">
            <div class="photo-img-wrapper">
              <img 
                src={photo.r2} 
                alt={photo.title} 
                loading="lazy"
                onerror={`this.src='${photo.local}'`}
              />
              <div class="photo-overlay">
                <a href={photo.r2} target="_blank" rel="noopener noreferrer" class="zoom-btn" title="View full image">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  <span>Zoom Image</span>
                </a>
              </div>
            </div>
            <div class="photo-body">
              <h3 class="photo-title">{photo.title}</h3>
              <p class="photo-desc">{photo.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <style>
    .malnutrition-overview-section {
      padding: 60px 0;
      background: var(--bg-white);
    }
    .overview-grid {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 35px;
      align-items: center;
    }
    .overview-img-box img {
      width: 200px;
      height: 200px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid var(--accent-gold);
      box-shadow: var(--shadow-md);
    }
    .overview-desc {
      font-size: 17px;
      color: var(--primary-dark);
      margin-bottom: 10px;
      line-height: 1.6;
    }
    .overview-subtext {
      font-size: 15px;
      line-height: 1.75;
      color: var(--text-dark);
      margin-bottom: 24px;
    }
    .objective-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .obj-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px;
      background: var(--bg-light);
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--primary-color);
    }
    .obj-icon {
      font-size: 22px;
    }
    .obj-title {
      font-size: 14.5px;
      font-weight: 700;
      color: var(--primary-dark);
      margin-bottom: 2px;
    }
    .obj-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.4;
    }

    .malnutrition-gallery-section {
      padding: 40px 0 80px;
      background: var(--bg-light);
    }
    .section-intro {
      text-align: center;
      margin-bottom: 45px;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .photo-card {
      background: #ffffff;
      border-top: 4px solid var(--primary-color);
      transition: var(--transition-fast);
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .photo-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-md);
      border-top-color: var(--accent-gold);
    }
    .photo-img-wrapper {
      position: relative;
      background: #f8faf8;
      padding: 10px;
      text-align: center;
    }
    .photo-img-wrapper img {
      width: 100%;
      height: 180px;
      object-fit: contain;
      object-position: center top;
      border-radius: var(--radius-sm);
      transition: transform 0.3s ease;
    }
    .photo-card:hover .photo-img-wrapper img {
      transform: scale(1.03);
    }
    .photo-overlay {
      position: absolute;
      inset: 10px;
      background: rgba(0, 77, 0, 0.75);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
      border-radius: var(--radius-sm);
    }
    .photo-card:hover .photo-overlay {
      opacity: 1;
    }
    .zoom-btn {
      background: var(--accent-gold);
      color: #000000;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 50px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }
    .photo-body {
      padding: 16px;
      flex-grow: 1;
    }
    .photo-title {
      font-size: 15px;
      color: var(--primary-dark);
      margin-bottom: 6px;
      font-weight: 700;
    }
    .photo-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Responsive */
    @media (max-width: 1100px) {
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .objective-cards-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 768px) {
      .overview-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .overview-img-box img {
        margin: 0 auto;
      }
    }
    @media (max-width: 500px) {
      .gallery-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
