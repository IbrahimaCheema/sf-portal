---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Healthcare Programs – Shakarganj Foundation"
  description="Explore community clinics, specialist maternal healthcare, and child malnutrition programs by Shakarganj Foundation."
>
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <span>Our Work</span> <span>›</span>
        <span class="current">Healthcare</span>
      </div>
      <h1 class="hero_page_title">Healthcare & Malnutrition Control</h1>
      <p class="hero_subtitle">Providing subsidized OPD medical care, maternal health specialists, and emergency healthcare relief.</p>
    </div>
  </section>

  <section class="health-section">
    <div class="container">
      <div class="grid-3">
        <div class="card health-card">
          <div class="card-body">
            <span class="badge badge-accent">NUTRITION PROGRAM</span>
            <h3>SF-TMSG Fight Against Malnutrition</h3>
            <p>Targeted nutritional intervention for infants and young mothers suffering from acute malnutrition.</p>
          </div>
        </div>

        <div class="card health-card">
          <div class="card-body">
            <span class="badge badge-primary">MATERNAL CARE</span>
            <h3>Specialist Gynaecology & OPD</h3>
            <p>Dedicated medical team offering subsidized consultations, lab tests, and antenatal care.</p>
          </div>
        </div>

        <div class="card health-card">
          <div class="card-body">
            <span class="badge badge-primary">COMMUNITY CAMPS</span>
            <h3>Healthcare Heroes Camps</h3>
            <p>Free mobile health camps serving remote villages with diagnostic screening and essential medicine.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .health-section {
      padding: 70px 0;
    }
    .health-card {
      border-top: 4px solid var(--primary-color);
      height: 100%;
    }
    .health-card h3 {
      font-size: 20px;
      margin: 15px 0 10px;
      color: var(--primary-dark);
    }
    .health-card p {
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.6;
    }
  </style>
</Layout>
