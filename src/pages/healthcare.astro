---
import Layout from '../layouts/Layout.astro';

const stationedGallery = [
  { r2: "https://docs.sf.org.pk/images/hc_disp_1.jpg", local: "/images/hc_disp_1.jpg", title: "Free OPD Consultation" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_2.jpg", local: "/images/hc_disp_2.jpg", title: "Medicine Distribution" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_3.jpg", local: "/images/hc_disp_3.jpg", title: "Patient Vital Checks" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_4.jpg", local: "/images/hc_disp_4.jpg", title: "Doctor Examination" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_5.jpg", local: "/images/hc_disp_5.jpg", title: "Nursing Care Unit" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_6.jpg", local: "/images/hc_disp_6.jpg", title: "SML Dispensary Jhang" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_7.jpg", local: "/images/hc_disp_7.jpg", title: "Community Health Service" },
  { r2: "https://docs.sf.org.pk/images/hc_disp_8.jpg", local: "/images/hc_disp_8.jpg", title: "Patient Record Entry" }
];

const mobileGallery = [
  { r2: "https://docs.sf.org.pk/images/hc_mobile_1.jpg", local: "/images/hc_mobile_1.jpg", title: "Mobile Clinic Field Unit" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_2.jpg", local: "/images/hc_mobile_2.jpg", title: "Rural Patient Screening" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_3.jpg", local: "/images/hc_mobile_3.jpg", title: "Doctor Consultation Van" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_4.jpg", local: "/images/hc_mobile_4.jpg", title: "Free Medicine Dispensing" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_5.jpg", local: "/images/hc_mobile_5.jpg", title: "Chund Bharwana Medical Camp" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_6.jpg", local: "/images/hc_mobile_6.jpg", title: "Gilmala Health Station" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_7.jpg", local: "/images/hc_mobile_7.jpg", title: "Kot Lakhnana Outreach" },
  { r2: "https://docs.sf.org.pk/images/hc_mobile_8.jpg", local: "/images/hc_mobile_8.jpg", title: "Shabeerabad Care Visit" }
];

const limbsGallery = [
  { r2: "https://docs.sf.org.pk/images/hc_limbs_1.jpg", local: "/images/hc_limbs_1.jpg", title: "Artificial Limb Fitting" },
  { r2: "https://docs.sf.org.pk/images/hc_limbs_2.jpg", local: "/images/hc_limbs_2.jpg", title: "Rehabilitation Session" },
  { r2: "https://docs.sf.org.pk/images/hc_limbs_3.jpg", local: "/images/hc_limbs_3.jpg", title: "ICRC Technical Support" },
  { r2: "https://docs.sf.org.pk/images/hc_limbs_4.jpg", local: "/images/hc_limbs_4.jpg", title: "Patient Mobility Recovery" }
];
---

<Layout 
  title="Healthcare Initiatives & Free Dispensaries – Shakarganj Foundation"
  description="Discover Shakarganj Foundation's Healthcare Department operating Stationed & Mobile Free Dispensaries and Artificial Limbs implantation."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <span>Our Work</span> <span>›</span>
        <span class="current">Healthcare</span>
      </div>
      <h1 class="hero_page_title">Healthcare Initiatives</h1>
      <p class="hero_subtitle">Delivering free medical care, mobile health clinics, and artificial limbs to rural communities across Punjab and AJK.</p>
    </div>
  </section>

  <!-- Impact Counter Banner -->
  <section class="impact-counter-section">
    <div class="container">
      <div class="counter-grid">
        <div class="counter-card">
          <div class="counter-num">249,710+</div>
          <div class="counter-label">Stationed Dispensary Patients</div>
        </div>
        <div class="counter-card">
          <div class="counter-num">306,738+</div>
          <div class="counter-label">Mobile Clinic Patients</div>
        </div>
        <div class="counter-card">
          <div class="counter-num">249+</div>
          <div class="counter-label">Artificial Limbs Implanted</div>
        </div>
        <div class="counter-card">
          <div class="counter-num">4</div>
          <div class="counter-label">Daily Outreach Health Centers</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-programs Callout Grid -->
  <section class="subprograms-section">
    <div class="container">
      <div class="grid-2 subprogram-callouts">
        <div class="card callout-card">
          <div class="card-body">
            <span class="badge badge-accent">NUTRITION PROGRAM</span>
            <h3 class="callout-title">SF-TMSG Fight Against Malnutrition</h3>
            <p class="callout-desc">Targeted therapeutic feeding and nutritional intervention for malnourished infants and nursing mothers in collaboration with TMSG.</p>
            <a href="/sf-tmsg-fight-against-malnutrition/" class="read-more-btn">
              <span>EXPLORE NUTRITION PROGRAM</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
        </div>

        <div class="card callout-card">
          <div class="card-body">
            <span class="badge badge-primary">COMMUNITY CAMPS</span>
            <h3 class="callout-title">Healthcare Heroes</h3>
            <p class="callout-desc">Honoring dedicated medical doctors, specialists, and field health workers delivering emergency medical relief in remote areas.</p>
            <a href="/healthcare-heroes/" class="read-more-btn">
              <span>MEET HEALTHCARE HEROES</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Healthcare Main Programs -->
  <section class="health-main-section">
    <div class="container">

      <!-- Section 1: Stationed Free Dispensaries -->
      <div class="health-program-block">
        <div class="program-grid">
          <div class="program-img-box">
            <img 
              src="https://docs.sf.org.pk/images/hc_stationed_dispensary.jpg" 
              alt="Stationed Free Dispensaries"
              loading="lazy"
              onerror="this.src='/images/hc_stationed_dispensary.jpg'"
            />
          </div>
          <div class="program-text-box">
            <span class="badge badge-primary">STATIONED CLINICS</span>
            <h2 class="program-title">Stationed Free Dispensaries</h2>
            <p class="program-desc">
              Shakarganj Foundation’s Healthcare Department was created in 2003 with the establishment of our first <strong>Stationed Free Dispensary at SML I Jhang</strong>, followed by a second facility at <strong>SML II Bhone in August 2010</strong>. Staffed by qualified doctors and nursing personnel, these dispensaries provide free medical consultations, diagnostics, and essential medicines to Shakarganj employees and local community members across Jhang and Bhone.
            </p>
            <div class="stat-pill-box">
              <span class="stat-pill"><strong>249,710+</strong> Total Patients Treated</span>
            </div>
          </div>
        </div>

        <!-- Gallery Grid -->
        <div class="gallery-wrapper">
          <h4 class="gallery-header-title">Stationed Dispensaries Activity Gallery</h4>
          <div class="grid-4 gallery-grid">
            {stationedGallery.map((item) => (
              <div class="photo-card card">
                <div class="photo-img-wrapper">
                  <img 
                    src={item.r2} 
                    alt={item.title}
                    loading="lazy"
                    onerror={`this.src='${item.local}'`}
                  />
                  <div class="photo-overlay">
                    <a href={item.r2} target="_blank" rel="noopener noreferrer" class="zoom-btn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                      <span>Zoom</span>
                    </a>
                  </div>
                </div>
                <div class="photo-caption">{item.title}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Section 2: Mobile Free Dispensaries -->
      <div class="health-program-block">
        <div class="program-grid reverse-grid">
          <div class="program-img-box">
            <img 
              src="https://docs.sf.org.pk/images/hc_mobile_dispensary.jpg" 
              alt="Mobile Free Dispensaries"
              loading="lazy"
              onerror="this.src='/images/hc_mobile_dispensary.jpg'"
            />
          </div>
          <div class="program-text-box">
            <span class="badge badge-accent">MOBILE CLINICS</span>
            <h2 class="program-title">Mobile Free Dispensaries Program</h2>
            <p class="program-desc">
              Established in 2003, our Mobile Free Dispensaries Program operates <strong>two custom-built Mobile Clinics</strong>—essentially medical facilities on wheels equipped as field hospitals. Manned by qualified doctors, medical officers, and paramedical staff, these mobile units visit four rural Medical Centers daily:
            </p>
            <ul class="centers-list">
              <li><strong>1. Shabeerabad</strong></li>
              <li><strong>2. Chund Bharwana</strong></li>
              <li><strong>3. Kot Lakhnana</strong></li>
              <li><strong>4. Gilmala</strong></li>
            </ul>
            <div class="stat-pill-box">
              <span class="stat-pill gold-pill"><strong>306,738+</strong> Patients Served in Remote Villages</span>
            </div>
          </div>
        </div>

        <!-- Gallery Grid -->
        <div class="gallery-wrapper">
          <h4 class="gallery-header-title">Mobile Clinics Field Outreach Gallery</h4>
          <div class="grid-4 gallery-grid">
            {mobileGallery.map((item) => (
              <div class="photo-card card">
                <div class="photo-img-wrapper">
                  <img 
                    src={item.r2} 
                    alt={item.title}
                    loading="lazy"
                    onerror={`this.src='${item.local}'`}
                  />
                  <div class="photo-overlay">
                    <a href={item.r2} target="_blank" rel="noopener noreferrer" class="zoom-btn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                      <span>Zoom</span>
                    </a>
                  </div>
                </div>
                <div class="photo-caption">{item.title}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Section 3: Implantation of Artificial Limbs -->
      <div class="health-program-block">
        <div class="program-grid">
          <div class="program-img-box">
            <img 
              src="https://docs.sf.org.pk/images/hc_artificial_limbs.png" 
              alt="Artificial Limbs Implantation"
              loading="lazy"
              onerror="this.src='/images/hc_artificial_limbs.png'"
            />
          </div>
          <div class="program-text-box">
            <span class="badge badge-primary">REHABILITATION & MOBILITY</span>
            <h2 class="program-title">Implantation of Artificial Limbs</h2>
            <p class="program-desc">
              Initiated on <strong>February 26, 2008</strong> in collaboration with the International Committee of the Red Cross (ICRC) at Muzaffarabad (AJK), this life-changing rehabilitation program is currently funded by <strong>Mian Altaf M. Saleem</strong>, Chairman of Shakarganj Foundation. To date, <strong>249 amputee patients</strong> have been custom-fitted with prosthetic limbs, restoring their physical independence and dignity.
            </p>
            <div class="stat-pill-box">
              <span class="stat-pill"><strong>249+</strong> Patients Implanted with Artificial Limbs</span>
            </div>
          </div>
        </div>

        <!-- Gallery Grid -->
        <div class="gallery-wrapper">
          <h4 class="gallery-header-title">Artificial Limbs Rehabilitation Gallery</h4>
          <div class="grid-4 gallery-grid">
            {limbsGallery.map((item) => (
              <div class="photo-card card">
                <div class="photo-img-wrapper">
                  <img 
                    src={item.r2} 
                    alt={item.title}
                    loading="lazy"
                    onerror={`this.src='${item.local}'`}
                  />
                  <div class="photo-overlay">
                    <a href={item.r2} target="_blank" rel="noopener noreferrer" class="zoom-btn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                      <span>Zoom</span>
                    </a>
                  </div>
                </div>
                <div class="photo-caption">{item.title}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <style>
    .impact-counter-section {
      background: var(--primary-dark);
      padding: 40px 0;
      color: #ffffff;
    }
    .counter-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .counter-card {
      text-align: center;
      padding: 10px;
    }
    .counter-num {
      font-size: 30px;
      font-weight: 800;
      color: var(--accent-gold);
    }
    .counter-label {
      font-size: 13.5px;
      opacity: 0.9;
      margin-top: 4px;
    }
    .subprograms-section {
      padding: 50px 0 20px;
      background: var(--bg-white);
    }
    .callout-card {
      border-top: 4px solid var(--primary-color);
      transition: var(--transition-fast);
    }
    .callout-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }
    .callout-title {
      font-size: 20px;
      color: var(--primary-dark);
      margin: 10px 0 8px;
    }
    .callout-desc {
      font-size: 14.5px;
      color: var(--text-muted);
      margin-bottom: 16px;
      line-height: 1.6;
    }
    .health-main-section {
      padding: 40px 0 80px;
      background: var(--bg-white);
    }
    .health-program-block {
      margin-bottom: 70px;
    }
    .program-grid {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 30px;
      align-items: center;
      margin-bottom: 30px;
    }
    .reverse-grid {
      grid-template-columns: 1fr 180px;
    }
    .reverse-grid .program-img-box {
      order: 2;
    }
    .reverse-grid .program-text-box {
      order: 1;
    }
    .program-img-box img {
      width: 160px;
      height: 160px;
      object-fit: cover;
      border-radius: 50%;
      border: 3px solid var(--accent-gold);
      box-shadow: var(--shadow-sm);
    }
    .program-title {
      font-size: 24px;
      color: var(--primary-dark);
      margin: 8px 0 10px;
    }
    .program-desc {
      font-size: 15px;
      line-height: 1.75;
      color: var(--text-dark);
      margin-bottom: 15px;
    }
    .centers-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      list-style: none;
      padding: 0;
      margin-bottom: 16px;
    }
    .centers-list li {
      background: var(--bg-light);
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--accent-gold);
      font-size: 14px;
      color: var(--text-dark);
    }
    .stat-pill-box {
      margin-top: 10px;
    }
    .stat-pill {
      display: inline-block;
      background: rgba(0, 77, 0, 0.08);
      color: var(--primary-color);
      padding: 8px 16px;
      border-radius: 50px;
      font-size: 14px;
      border: 1px solid rgba(0, 77, 0, 0.15);
    }
    .gold-pill {
      background: #fff3e0;
      color: #b36b00;
      border-color: rgba(255, 167, 53, 0.3);
    }
    .gallery-wrapper {
      background: var(--bg-light);
      border-radius: var(--radius-md);
      padding: 24px;
      border: 1px solid var(--border-light);
    }
    .gallery-header-title {
      font-size: 16px;
      color: var(--primary-dark);
      margin-bottom: 18px;
      text-align: center;
      font-weight: 700;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .photo-card {
      background: #ffffff;
      border-radius: var(--radius-sm);
      overflow: hidden;
      transition: var(--transition-fast);
      border: 1px solid var(--border-light);
    }
    .photo-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }
    .photo-img-wrapper {
      position: relative;
    }
    .photo-img-wrapper img {
      width: 100%;
      height: 140px;
      object-fit: cover;
    }
    .photo-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 77, 0, 0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .photo-card:hover .photo-overlay {
      opacity: 1;
    }
    .zoom-btn {
      background: var(--accent-gold);
      color: #000000;
      font-size: 12px;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 50px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }
    .photo-caption {
      padding: 10px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-dark);
      text-align: center;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .counter-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .program-grid, .reverse-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .program-img-box img {
        margin: 0 auto;
      }
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .centers-list {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 500px) {
      .counter-grid {
        grid-template-columns: 1fr;
      }
      .gallery-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
