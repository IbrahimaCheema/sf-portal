---
import Layout from '../layouts/Layout.astro';
import ActivitiesEvents from '../components/ActivitiesEvents.astro';

// Array of all 19 Revolution Slider images delivered exclusively via Cloudflare R2 (https://docs.sf.org.pk)
const sliderImages = [
  { src: 'https://docs.sf.org.pk/images/slider_1.jpg', title: 'Inaugural Ceremony of Shakarganj Foundation & Fitwell Hub' },
  { src: 'https://docs.sf.org.pk/images/slider_2.png', title: 'Shakarganj Community Banner' },
  { src: 'https://docs.sf.org.pk/images/slider_3.png', title: 'Healthcare Gynaecologist Addition' },
  { src: 'https://docs.sf.org.pk/images/slider_4.png', title: 'Shakarganj Foundation Initiative' },
  { src: 'https://docs.sf.org.pk/images/slider_5.png', title: 'Shakarganj Vocational Lab 1' },
  { src: 'https://docs.sf.org.pk/images/slider_6.png', title: 'Shakarganj Slider Picture 3' },
  { src: 'https://docs.sf.org.pk/images/slider_7.png', title: 'RUFT Design Banner' },
  { src: 'https://docs.sf.org.pk/images/slider_8.png', title: 'Shakarganj Vocational Lab 2' },
  { src: 'https://docs.sf.org.pk/images/slider_9.png', title: 'Shakarganj Slider Picture 2' },
  { src: 'https://docs.sf.org.pk/images/slider_10.png', title: 'Shakarganj Vocational Lab 3' },
  { src: 'https://docs.sf.org.pk/images/slider_11.png', title: 'Shakarganj Educational Drive' },
  { src: 'https://docs.sf.org.pk/images/slider_12.jpg', title: 'Shakarganj Event Highlight' },
  { src: 'https://docs.sf.org.pk/images/slider_13.png', title: 'Shakarganj Banner 2024' },
  { src: 'https://docs.sf.org.pk/images/slider_14.jpg', title: 'Community Distribution Ceremony' },
  { src: 'https://docs.sf.org.pk/images/slider_15.png', title: 'Healthcare Support Program' },
  { src: 'https://docs.sf.org.pk/images/slider_16.jpg', title: 'Shakarganj Field Activity' },
  { src: 'https://docs.sf.org.pk/images/slider_17.png', title: 'Food Drive Campaign' },
  { src: 'https://docs.sf.org.pk/images/slider_18.png', title: 'Education Support Drive' },
  { src: 'https://docs.sf.org.pk/images/slider_19.jpg', title: 'Jhang Art & Vocational Crafts' }
];

// Array of ALL 25 Collaboration Partner Logos delivered exclusively via Cloudflare R2 (https://docs.sf.org.pk)
const collaborationLogos = [
  { name: 'Shakarganj Mills Limited (SML)', src: 'https://docs.sf.org.pk/images/sml_logo.png' },
  { name: 'Fatima Group', src: 'https://docs.sf.org.pk/images/fatima_group.jpeg' },
  { name: 'Lions Club', src: 'https://docs.sf.org.pk/images/lions_club.png' },
  { name: 'DHQ Hospital', src: 'https://docs.sf.org.pk/images/dhq_hospital.png' },
  { name: 'Indus Hospital & Health Network', src: 'https://docs.sf.org.pk/images/indus_hospital.png' },
  { name: 'Shaigan Pharmaceuticals', src: 'https://docs.sf.org.pk/images/shaigan.png' },
  { name: 'Searle Company Limited', src: 'https://docs.sf.org.pk/images/searle.png' },
  { name: 'Asian Food Industries', src: 'https://docs.sf.org.pk/images/asian_food.png' },
  { name: 'TMSG', src: 'https://docs.sf.org.pk/images/tmsg.png' },
  { name: 'IWH', src: 'https://docs.sf.org.pk/images/iwh.png' },
  { name: 'Getz Pharma', src: 'https://docs.sf.org.pk/images/getz_pharma.png' },
  { name: 'Atco Laboratories', src: 'https://docs.sf.org.pk/images/atco_lab.png' },
  { name: 'Bilal Medical Complex (BMC)', src: 'https://docs.sf.org.pk/images/bmc.png' },
  { name: 'Muhammad Medical Complex (MMC)', src: 'https://docs.sf.org.pk/images/mmc.png' },
  { name: 'PBM Sweet Home', src: 'https://docs.sf.org.pk/images/sweet_home.png' },
  { name: 'Genix Pharma', src: 'https://docs.sf.org.pk/images/genix.png' },
  { name: 'PharmEvo', src: 'https://docs.sf.org.pk/images/pharmevo.png' },
  { name: 'Standpharm Pakistan', src: 'https://docs.sf.org.pk/images/standpharm.png' },
  { name: 'Hirani Pharmaceuticals', src: 'https://docs.sf.org.pk/images/hirani.jpg' },
  { name: 'Solace Pharma', src: 'https://docs.sf.org.pk/images/solace.png' },
  { name: 'Saffron Pharma', src: 'https://docs.sf.org.pk/images/saffron.jpg' },
  { name: 'Cell Laboratories', src: 'https://docs.sf.org.pk/images/cell_lab.jpg' },
  { name: 'Hilton Pharma', src: 'https://docs.sf.org.pk/images/hilton.jpg' },
  { name: 'Highnoon Laboratories', src: 'https://docs.sf.org.pk/images/highnoon.jpg' },
  { name: 'Tabros Pharma', src: 'https://docs.sf.org.pk/images/tabros.png' }
];
---

<Layout 
  title="Shakarganj Foundation – Uplifting Communities & Transforming Lives"
  description="Shakarganj Foundation is dedicated to providing quality education, affordable healthcare, child nutrition, and socio-economic support across Pakistan."
>
  <!-- 🎠 Naked Image Hero Carousel Section -->
  <section class="hero-slider-section">
    <div class="slider-container">
      {sliderImages.map((img, index) => (
        <div class={`slide ${index === 0 ? 'active' : ''}`} data-slide-index={index}>
          <img 
            src={img.src} 
            alt={img.title} 
            class="slide-img"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}

      <!-- Slider Controls -->
      <button class="slider-btn prev-btn" id="prevSlide" aria-label="Previous Slide">❮</button>
      <button class="slider-btn next-btn" id="nextSlide" aria-label="Next Slide">❯</button>
      
      <!-- Dots Indicator -->
      <div class="slider-dots" id="sliderDots">
        {sliderImages.map((_, index) => (
          <span class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></span>
        ))}
      </div>
    </div>
  </section>

  <!-- 🌿 Compact 25+ Years of Community Service Banner -->
  <section class="anniversary-banner">
    <div class="particles-bg"></div>
    <div class="container banner-content">
      <h2 class="banner-title">25+ Years of Community Service</h2>
      <p class="banner-desc">
        Shakarganj Foundation has been providing free of cost education assistance, healthcare services and practical home economics programs in remote areas of Pakistan’s Punjab province for over two decades
      </p>
    </div>
  </section>

  <!-- 🖼️ 3 Interactive Program Cards Section -->
  <section class="program-cards-section">
    <div class="container">
      <div class="program-cards-grid">
        
        <!-- Card 1: Education -->
        <a href="/education" class="program-card">
          <div class="card-bg-wrapper">
            <img 
              src="https://docs.sf.org.pk/images/card_education.png" 
              alt="Education Program - Adopted Schools" 
              class="card-bg-img" 
            />
            <div class="card-default-bar">
              <div class="card-icon scholar-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
              </div>
              <span class="card-title">Education</span>
            </div>
          </div>
          <div class="card-hover-overlay">
            <div class="hover-header">
              <div class="card-icon scholar-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
              </div>
              <span class="hover-title">Education</span>
            </div>
            <ul class="hover-sublist">
              <li>Adopted Schools</li>
              <li>Nutrition Program</li>
              <li>Adult Literacy Program</li>
            </ul>
            <span class="read-more-link">read more ›</span>
          </div>
        </a>

        <!-- Card 2: Healthcare -->
        <a href="/healthcare" class="program-card">
          <div class="card-bg-wrapper">
            <img 
              src="https://docs.sf.org.pk/images/card_healthcare.jpg" 
              alt="Healthcare Program - Free Dispensaries" 
              class="card-bg-img" 
            />
            <div class="card-default-bar">
              <div class="card-icon med-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6h-3V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-9-2h4v2h-4V4zm8 16H6V8h13v12zm-5-7h-2v-2H11v2H9v2h2v2h2v-2h2v-2z"/></svg>
              </div>
              <span class="card-title">Healthcare</span>
            </div>
          </div>
          <div class="card-hover-overlay">
            <div class="hover-header">
              <div class="card-icon med-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6h-3V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-9-2h4v2h-4V4zm8 16H6V8h13v12zm-5-7h-2v-2H11v2H9v2h2v2h2v-2h2v-2z"/></svg>
              </div>
              <span class="hover-title">Healthcare</span>
            </div>
            <ul class="hover-sublist">
              <li>Stationed Free Dispensaries</li>
              <li>Mobile Free Dispensaries</li>
              <li>Artificial Limbs</li>
            </ul>
            <span class="read-more-link">read more ›</span>
          </div>
        </a>

        <!-- Card 3: Jhang Art Gallery -->
        <a href="/jhang-art-gallery" class="program-card">
          <div class="card-bg-wrapper">
            <img 
              src="https://docs.sf.org.pk/images/card_art.png" 
              alt="Jhang Art Gallery - Fine Arts and Crafts" 
              class="card-bg-img" 
            />
            <div class="card-default-bar">
              <div class="card-icon gallery-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              </div>
              <span class="card-title">Jhang Art Gallery</span>
            </div>
          </div>
          <div class="card-hover-overlay">
            <div class="hover-header">
              <div class="card-icon gallery-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              </div>
              <span class="hover-title">Jhang Art Gallery</span>
            </div>
            <ul class="hover-sublist">
              <li>Fine Arts</li>
              <li>Fashion Designing</li>
            </ul>
            <span class="read-more-link">read more ›</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- 📊 Warm Orange Animated Counter Section -->
  <section class="animated-counter-section">
    <div class="container">
      <div class="counter-grid">
        <div class="counter-item">
          <div class="counter-number" data-target="22">0</div>
          <div class="counter-label">SCHOOLS</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="5304">0</div>
          <div class="counter-label">STUDENTS</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="208">0</div>
          <div class="counter-label">TEACHERS</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="6">0</div>
          <div class="counter-label">DISPENSARIES</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="2023450">0</div>
          <div class="counter-label">FUNDS RAISED 2025-2026</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 🔍 At A Glance Section -->
  <section class="at-a-glance-section">
    <div class="container">
      <h2 class="glance-title">At A Glance</h2>
      <div class="glance-decorator"></div>

      <div class="glance-grid">
        <!-- 1. Established -->
        <div class="glance-item">
          <div class="glance-icon-box">
            <svg viewBox="0 0 100 100" width="60" height="60" class="hex-svg">
              <polygon points="50,5 93,26 93,74 50,95 7,74 7,26" fill="none" stroke="#ffa735" stroke-width="5"/>
              <path d="M30 65h40V42H30v23zm6-17h28v11H36V48zM25 36l25-14 25 14v4H25v-4z" fill="#ffa735"/>
            </svg>
          </div>
          <div class="glance-text">
            <h3>Established</h3>
            <p>A non-profit organization since 2000</p>
          </div>
        </div>

        <!-- 2. Registrations -->
        <div class="glance-item">
          <div class="glance-icon-box">
            <svg viewBox="0 0 100 100" width="60" height="60" class="hex-svg">
              <polygon points="50,5 93,26 93,74 50,95 7,74 7,26" fill="none" stroke="#ffa735" stroke-width="5"/>
              <circle cx="50" cy="50" r="22" fill="none" stroke="#ffa735" stroke-width="4"/>
              <text x="50" y="58" font-size="24" font-weight="bold" fill="#ffa735" text-anchor="middle">R</text>
            </svg>
          </div>
          <div class="glance-text">
            <h3>Registrations</h3>
            <ul class="glance-list">
              <li>Societies Registration Act 1860</li>
              <li>Punjab Charity Commission</li>
              <li>Federal Board of Revenue (FBR)</li>
            </ul>
          </div>
        </div>

        <!-- 3. Our Community -->
        <div class="glance-item">
          <div class="glance-icon-box">
            <svg viewBox="0 0 100 100" width="60" height="60" class="hex-svg">
              <polygon points="50,5 93,26 93,74 50,95 7,74 7,26" fill="none" stroke="#ffa735" stroke-width="5"/>
              <g fill="#ffa735">
                <!-- Center Person -->
                <circle cx="50" cy="37" r="6.5"/>
                <path d="M38 59c0-6.6 5.4-12 12-12s12 5.4 12 12v3H38v-3z"/>
                <!-- Left Person -->
                <circle cx="34" cy="41" r="5"/>
                <path d="M24 59c0-5 4-9 9-9h2c1.3 0 2.6.3 3.8.8-1.7 2.1-2.8 4.7-2.8 7.7v3.5H24V59z"/>
                <!-- Right Person -->
                <circle cx="66" cy="41" r="5"/>
                <path d="M67 50.8c4.8 0 8.8 3.9 8.8 8.7v3.5H63.8v-3.5c0-3-1.1-5.6-2.8-7.7 1.2-.5 2.5-.8 3.8-.8h2.2z"/>
              </g>
            </svg>
          </div>
          <div class="glance-text">
            <h3>Our Community</h3>
            <p>Our education and healthcare services help individuals who need it the most and enhance their daily lives. Our goal is to transform them into the future leaders of Pakistan</p>
          </div>
        </div>

        <!-- 4. Our Slogan -->
        <div class="glance-item">
          <div class="glance-icon-box">
            <svg viewBox="0 0 100 100" width="60" height="60" class="hex-svg">
              <polygon points="50,5 93,26 93,74 50,95 7,74 7,26" fill="none" stroke="#ffa735" stroke-width="5"/>
              <path d="M30 40v20h10l15 12V28L40 40H30zm30 10c0-6-3.5-11-8.5-13v26c5-2 8.5-7 8.5-13z" fill="#ffa735"/>
            </svg>
          </div>
          <div class="glance-text">
            <h3>Our Slogan</h3>
            <p>Education and Healthcare for everyone</p>
          </div>
        </div>

        <!-- 5. Our Values -->
        <div class="glance-item">
          <div class="glance-icon-box">
            <svg viewBox="0 0 100 100" width="60" height="60" class="hex-svg">
              <polygon points="50,5 93,26 93,74 50,95 7,74 7,26" fill="none" stroke="#ffa735" stroke-width="5"/>
              <path d="M38 52l6 6 18-18 4 4-22 22-10-10z" fill="#ffa735"/>
            </svg>
          </div>
          <div class="glance-text">
            <h3>Our Values</h3>
            <ul class="glance-list">
              <li>Honesty</li>
              <li>Sincerity</li>
              <li>Justice</li>
              <li>Commitment</li>
              <li>Empathy</li>
              <li>Ownership</li>
            </ul>
          </div>
        </div>

        <!-- 6. Recent Projects -->
        <div class="glance-item">
          <div class="glance-icon-box">
            <svg viewBox="0 0 100 100" width="60" height="60" class="hex-svg">
              <polygon points="50,5 93,26 93,74 50,95 7,74 7,26" fill="none" stroke="#ffa735" stroke-width="5"/>
              <path d="M68 40h-8.2l-6.8-6.8c-1.6-1.6-4.2-1.6-5.8 0L38.4 42l-5.6-5.6c-1.6-1.6-4.2-1.6-5.8 0L20 43.4V58h60V40h-12zm-32 8l8-8 12 12-8 8-12-12zm24 8l-6-6 6-6 6 6-6 6z" fill="#ffa735"/>
            </svg>
          </div>
          <div class="glance-text">
            <h3>Recent Projects</h3>
            <ul class="glance-list">
              <li>Female Adult Literacy Program</li>
              <li>Shakarganj Vocational Lab</li>
              <li>SF – Fitwell Hub Collaboration</li>
              <li>Darkhshan Model School</li>
              <li>Gynae Medical Camp</li>
              <li>SF-TMSG Fight Against Malnutrition</li>
              <li>Flavored Milk Distribution</li>
              <li>Fruit Distribution Drive</li>
            </ul>

            <div class="more-projects-wrapper" id="moreProjects" style="display: none;">
              <ul class="glance-list">
                <li>Sports Gear Donation Seminar</li>
                <li>Talib Hussain Education Scholarship</li>
                <li>Winter Clothing Distribution Drive</li>
                <li>Shoes and Socks Distribution</li>
                <li>Rice and Sugar Distribution</li>
                <li>Disbursement of Furniture</li>
                <li>Food Distribution Drive</li>
                <li>Community Food Drive</li>
                <li>General Medical Camp</li>
                <li>Dermatology Camp</li>
                <li>Nutritional Camp</li>
                <li>Blood Sugar and Hepatitis Screening Camp</li>
                <li>Dental Camp</li>
                <li>Eye Examination Camp</li>
                <li>Flood Medical Relief Camps</li>
              </ul>
            </div>

            <button class="more-btn" id="toggleProjectsBtn">More</button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 📸 Instagram Feed Section: Activities & Events -->
  <ActivitiesEvents />

  <!-- 🤝 Collaborations Infinite Moving Logo Marquee Section (Directly before Footer) -->
  <section class="collaborations-section">
    <div class="container">
      <h2 class="collab-title">Collaborations</h2>
      <div class="collab-decorator"></div>
    </div>

    <div class="marquee-container">
      <div class="marquee-track">
        <!-- Duplicated array for seamless 100% infinite left-to-right marquee scroll -->
        {[...collaborationLogos, ...collaborationLogos].map((logo, index) => (
          <div class="logo-item" key={index}>
            <img 
              src={logo.src} 
              alt={logo.name} 
              title={logo.name}
              class="collab-logo-img" 
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* 🎠 Naked Slider Styles */
    .hero-slider-section {
      position: relative;
      background-color: #ffffff;
      padding: 0;
      overflow: hidden;
    }

    .slider-container {
      position: relative;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      min-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0f4f0;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      overflow: hidden;
    }

    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease, visibility 0.5s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide.active {
      opacity: 1;
      visibility: visible;
    }

    .slide-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .slider-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      background: rgba(0, 77, 0, 0.75);
      color: #ffffff;
      border: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-fast);
      box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }

    .slider-btn:hover {
      background: var(--accent-gold);
      color: #000000;
    }

    .prev-btn { left: 16px; }
    .next-btn { right: 16px; }

    .slider-dots {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      gap: 6px;
      max-width: 90%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.75);
      border: 1px solid var(--primary-color);
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .dot.active {
      background: var(--accent-gold);
      border-color: var(--accent-gold);
      width: 22px;
      border-radius: 5px;
    }

    /* 🌿 Compact 25+ Years Anniversary Banner */
    .anniversary-banner {
      position: relative;
      background-color: #74ad66;
      color: #ffffff;
      padding: 16px 20px;
      text-align: center;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      margin-bottom: 0;
    }

    .particles-bg {
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.25) 1.5px, transparent 1.5px),
        radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px),
        radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.15) 1.5px, transparent 1.5px),
        radial-gradient(circle at 30% 70%, rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px),
        radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px);
      background-size: 80px 80px;
      pointer-events: none;
    }

    .banner-content {
      position: relative;
      z-index: 2;
