---
import Layout from '../layouts/Layout.astro';

// Array of all 19 Revolution Slider images from sf.org.pk
const sliderImages = [
  { src: '/images/slider_1.jpg', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/01/WhatsApp-Image-2025-01-15-at-11.44.49-AM.jpeg', title: 'Inaugural Ceremony of Shakarganj Foundation & Fitwell Hub' },
  { src: '/images/slider_2.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/11/slider-27.png', title: 'Shakarganj Community Banner' },
  { src: '/images/slider_3.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/09/Shakarganj-Foundation-Adds-Gynaecologist-to-Healthcare-Team-1150-x-600-px.png', title: 'Healthcare Gynaecologist Addition' },
  { src: '/images/slider_4.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/11/slider-29.png', title: 'Shakarganj Foundation Initiative' },
  { src: '/images/slider_5.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/12/Shakarganj-Vocational-Lab-Instagram-Post-45-1200-x-600-px-1.png', title: 'Shakarganj Vocational Lab 1' },
  { src: '/images/slider_6.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/12/SF-Website-Slider-Pic-1200-x-600-px-3.png', title: 'Shakarganj Slider Picture 3' },
  { src: '/images/slider_7.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/11/RUFT-Design-3.png', title: 'RUFT Design Banner' },
  { src: '/images/slider_8.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/12/Shakarganj-Vocational-Lab-Instagram-Post-45-1200-x-600-px.png', title: 'Shakarganj Vocational Lab 2' },
  { src: '/images/slider_9.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/11/Copy-of-SF-Website-Slider-Pic-1200-x-600-px-2.png', title: 'Shakarganj Slider Picture 2' },
  { src: '/images/slider_10.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/12/Shakarganj-Vocational-Lab-Instagram-Post-45-1200-x-600-px-2.png', title: 'Shakarganj Vocational Lab 3' },
  { src: '/images/slider_11.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/12/Untitled-design.png', title: 'Shakarganj Educational Drive' },
  { src: '/images/slider_12.jpg', fallback: 'https://www.sf.org.pk/wp-content/uploads/2025/02/479389759_599852552931525_3865703827591218268_n.jpg', title: 'Shakarganj Event Highlight' },
  { src: '/images/slider_13.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/02/slider-20240228.png', title: 'Shakarganj Banner 2024' },
  { src: '/images/slider_14.jpg', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/02/WhatsApp-Image-2024-02-28-at-3.15.30-PM.jpeg', title: 'Community Distribution Ceremony' },
  { src: '/images/slider_15.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2023/09/slider-2.png', title: 'Healthcare Support Program' },
  { src: '/images/slider_16.jpg', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/08/WhatsApp-Image-2024-08-26-at-5.27.32-PM.jpeg', title: 'Shakarganj Field Activity' },
  { src: '/images/slider_17.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/01/food-drive-slider1.png', title: 'Food Drive Campaign' },
  { src: '/images/slider_18.png', fallback: 'https://www.sf.org.pk/wp-content/uploads/2023/09/slider-1.png', title: 'Education Support Drive' },
  { src: '/images/slider_19.jpg', fallback: 'https://www.sf.org.pk/wp-content/uploads/2024/01/fashion-slider-1.jpg', title: 'Jhang Art & Vocational Crafts' }
];
---

<Layout 
  title="Shakarganj Foundation – Uplifting Communities & Transforming Lives"
  description="Shakarganj Foundation is dedicated to providing quality education, affordable healthcare, child nutrition, and socio-economic support across Pakistan."
>
  <!-- 🎠 Naked Image Hero Carousel Section -->
  <section class="hero-slider-section">
    <div class="slider-container">
      {sliderImages.map((img, index) => (
        <div class={`slide ${index === 0 ? 'active' : ''}`} data-slide-index={index}>
          <img 
            src={img.src} 
            alt={img.title} 
            class="slide-img"
            onerror={`this.src='${img.fallback}'`}
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}

      <!-- Slider Controls -->
      <button class="slider-btn prev-btn" id="prevSlide" aria-label="Previous Slide">❮</button>
      <button class="slider-btn next-btn" id="nextSlide" aria-label="Next Slide">❯</button>
      
      <!-- Dots Indicator -->
      <div class="slider-dots" id="sliderDots">
        {sliderImages.map((_, index) => (
          <span class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></span>
        ))}
      </div>
    </div>
  </section>

  <!-- 🌿 Compact 25+ Years of Community Service Banner -->
  <section class="anniversary-banner">
    <div class="particles-bg"></div>
    <div class="container banner-content">
      <h2 class="banner-title">25+ Years of Community Service</h2>
      <p class="banner-desc">
        Shakarganj Foundation has been providing free of cost education assistance, healthcare services and practical home economics programs in remote areas of Pakistan’s Punjab province for over two decades
      </p>
    </div>
  </section>

  <!-- 🖼️ 3 Interactive Program Cards Section -->
  <section class="program-cards-section">
    <div class="container">
      <div class="program-cards-grid">
        
        <!-- Card 1: Education (Scholar Graduation Cap Icon) -->
        <a href="/education" class="program-card">
          <div class="card-bg-wrapper">
            <img 
              src="/images/card_education.png" 
              alt="Education Program - Adopted Schools" 
              class="card-bg-img" 
              onerror="this.src='https://www.sf.org.pk/wp-content/uploads/2023/07/education-1-350x250.png'"
            />
            <div class="card-default-bar">
              <div class="card-icon scholar-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
              </div>
              <span class="card-title">Education</span>
            </div>
          </div>
          <div class="card-hover-overlay">
            <div class="hover-header">
              <div class="card-icon scholar-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
              </div>
              <span class="hover-title">Education</span>
            </div>
            <ul class="hover-sublist">
              <li>Adopted Schools</li>
              <li>Nutrition Program</li>
              <li>Adult Literacy Program</li>
            </ul>
            <span class="read-more-link">read more ›</span>
          </div>
        </a>

        <!-- Card 2: Healthcare -->
        <a href="/healthcare" class="program-card">
          <div class="card-bg-wrapper">
            <img 
              src="/images/card_healthcare.jpg" 
              alt="Healthcare Program - Free Dispensaries" 
              class="card-bg-img" 
              onerror="this.src='https://www.sf.org.pk/wp-content/uploads/2023/09/373330647_268655812717869_6430380279538548162_n-1-e1694156256909-350x250.jpg'"
            />
            <div class="card-default-bar">
              <div class="card-icon med-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6h-3V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-9-2h4v2h-4V4zm8 16H6V8h13v12zm-5-7h-2v-2H11v2H9v2h2v2h2v-2h2v-2z"/></svg>
              </div>
              <span class="card-title">Healthcare</span>
            </div>
          </div>
          <div class="card-hover-overlay">
            <div class="hover-header">
              <div class="card-icon med-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6h-3V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-9-2h4v2h-4V4zm8 16H6V8h13v12zm-5-7h-2v-2H11v2H9v2h2v2h2v-2h2v-2z"/></svg>
              </div>
              <span class="hover-title">Healthcare</span>
            </div>
            <ul class="hover-sublist">
              <li>Stationed Free Dispensaries</li>
              <li>Mobile Free Dispensaries</li>
              <li>Artificial Limbs</li>
            </ul>
            <span class="read-more-link">read more ›</span>
          </div>
        </a>

        <!-- Card 3: Jhang Art Gallery -->
        <a href="/jhang-art-gallery" class="program-card">
          <div class="card-bg-wrapper">
            <img 
              src="/images/card_art.png" 
              alt="Jhang Art Gallery - Fine Arts and Crafts" 
              class="card-bg-img" 
              onerror="this.src='https://www.sf.org.pk/wp-content/uploads/2023/07/art-1-350x250.png'"
            />
            <div class="card-default-bar">
              <div class="card-icon gallery-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              </div>
              <span class="card-title">Jhang Art Gallery</span>
            </div>
          </div>
          <div class="card-hover-overlay">
            <div class="hover-header">
              <div class="card-icon gallery-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              </div>
              <span class="hover-title">Jhang Art Gallery</span>
            </div>
            <ul class="hover-sublist">
              <li>Fine Arts</li>
              <li>Fashion Designing</li>
            </ul>
            <span class="read-more-link">read more ›</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- 📊 Warm Orange Animated Counter Section -->
  <section class="animated-counter-section">
    <div class="container">
      <div class="counter-grid">
        <div class="counter-item">
          <div class="counter-number" data-target="22">0</div>
          <div class="counter-label">SCHOOLS</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="5304">0</div>
          <div class="counter-label">STUDENTS</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="208">0</div>
          <div class="counter-label">TEACHERS</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="6">0</div>
          <div class="counter-label">DISPENSARIES</div>
        </div>

        <div class="counter-item">
          <div class="counter-number" data-target="2023450">0</div>
          <div class="counter-label">FUNDS RAISED 2025-2026</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 💡 Strategic Focus Areas -->
  <section class="focus-section">
    <div class="container">
      <h2 class="section-title">Our Strategic Focus Areas</h2>
      <div class="title-decorator"></div>
      <p class="section-subtitle">Dedicated to creating holistic socio-economic impact through structured development initiatives.</p>

      <div class="grid-3">
        <!-- Focus 1: Education -->
        <div class="card focus-card">
          <div class="focus-icon-wrapper">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </div>
          <div class="card-body">
            <span class="badge badge-primary">PRIMARY & HIGHER ED</span>
            <h3>Education & Scholarships</h3>
            <p>Providing financial assistance, school supplies, and merit scholarships to promising students across rural and urban districts.</p>
            <a href="/education" class="card-link">Learn More ➔</a>
          </div>
        </div>

        <!-- Focus 2: Healthcare -->
        <div class="card focus-card">
          <div class="focus-icon-wrapper">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </div>
          <div class="card-body">
            <span class="badge badge-primary">HEALTH & WELLNESS</span>
            <h3>Healthcare & Nutrition</h3>
            <p>Delivering medical consultations, maternal healthcare, and structured nutritional campaigns to eradicate child malnutrition.</p>
            <a href="/healthcare" class="card-link">Learn More ➔</a>
          </div>
        </div>

        <!-- Focus 3: Art & Culture -->
        <div class="card focus-card">
          <div class="focus-icon-wrapper">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <div class="card-body">
            <span class="badge badge-primary">HERITAGE PRESERVATION</span>
            <h3>Jhang Art Gallery</h3>
            <p>Promoting local artisans, preserving traditional Pakistani craftsmanship, and fostering regional artistic heritage.</p>
            <a href="/jhang-art-gallery" class="card-link">Learn More ➔</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 🏛️ Founder's Vision Banner -->
  <section class="vision-banner">
    <div class="container vision-content">
      <div class="vision-text">
        <span class="badge badge-accent">FOUNDER'S LEGACY</span>
        <h2>Driven by Compassion & Service</h2>
        <p class="vision-quote">
          "True progress is achieved when every individual, regardless of background, has access to quality education, proper health management, and dignified opportunity."
        </p>
        <p class="vision-author">— Shakarganj Foundation Leadership</p>
        <div class="vision-actions">
          <a href="/founder" class="btn btn-accent">Read Founder's Story</a>
          <a href="/board-of-governors" class="btn btn-outline-white">Board of Governors</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 💳 Direct Donation Call-To-Action Card -->
  <section class="donate-cta-section">
    <div class="container">
      <div class="donate-cta-card">
        <div class="cta-info">
          <h2>Make a Lasting Impact Today</h2>
          <p>Your support provides essential healthcare supplies, educational grants, and vital nutrition to families in need.</p>
        </div>
        <div class="cta-bank">
          <div class="bank-box">
            <span class="label">Official Donation Account:</span>
            <div class="bank-name">MCB Bank Limited</div>
            <div class="account-num">0124301010014225</div>
            <span class="account-title">Account Title: Shakarganj Foundation</span>
          </div>
          <a href="/donate-now" class="btn btn-accent btn-lg">Donate Online Now</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* 🎠 Naked Slider Styles */
    .hero-slider-section {
      position: relative;
      background-color: #ffffff;
      padding: 0;
      overflow: hidden;
    }

    .slider-container {
      position: relative;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      min-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0f4f0;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      overflow: hidden;
    }

    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease, visibility 0.5s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide.active {
      opacity: 1;
      visibility: visible;
    }

    .slide-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .slider-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      background: rgba(0, 77, 0, 0.75);
      color: #ffffff;
      border: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-fast);
      box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }

    .slider-btn:hover {
      background: var(--accent-gold);
      color: #000000;
    }

    .prev-btn { left: 16px; }
    .next-btn { right: 16px; }

    .slider-dots {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      gap: 6px;
      max-width: 90%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.75);
      border: 1px solid var(--primary-color);
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .dot.active {
      background: var(--accent-gold);
      border-color: var(--accent-gold);
      width: 22px;
      border-radius: 5px;
    }

    /* 🌿 Compact 25+ Years Anniversary Banner */
    .anniversary-banner {
      position: relative;
      background-color: #74ad66;
      color: #ffffff;
      padding: 16px 20px;
      text-align: center;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      margin-bottom: 0;
    }

    .particles-bg {
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.25) 1.5px, transparent 1.5px),
        radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px),
        radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.15) 1.5px, transparent 1.5px),
        radial-gradient(circle at 30% 70%, rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px),
        radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.2) 1.5px, transparent 1.5px);
      background-size: 80px 80px;
      pointer-events: none;
    }

    .banner-content {
      position: relative;
      z-index: 2;
      max-width: 980px;
      margin: 0 auto;
    }

    .banner-title {
      font-family: var(--font-heading);
      font-size: 32px;
      font-weight: 800;
      color: #ffa735;
      margin-bottom: 4px;
      line-height: 1.2;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.12);
      letter-spacing: -0.3px;
    }

    .banner-desc {
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      line-height: 1.45;
      max-width: 940px;
      margin: 0 auto;
    }

    /* 🖼️ 3 Interactive Program Cards Section */
    .program-cards-section {
      padding: 35px 0;
      background-color: #ffffff;
    }

    .program-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .program-card {
      position: relative;
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      display: block;
      text-decoration: none;
      height: 310px;
      background-color: #f5a623;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .program-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .card-bg-wrapper {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
    }

    .card-bg-img {
      width: 100%;
      height: calc(100% - 60px);
      object-fit: cover;
      display: block;
    }

    .card-default-bar {
      height: 60px;
      background-color: #f5a623;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 16px;
    }

    .card-icon {
      background: #d92525;
      color: #ffffff;
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .card-title {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
    }

    /* 🌟 Hover / Tap Overlay Emerges */
    .card-hover-overlay {
      position: absolute;
      inset: 0;
      background-color: rgba(245, 166, 35, 0.95);
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s ease, visibility 0.35s ease;
      z-index: 10;
    }

    .program-card:hover .card-hover-overlay,
    .program-card:focus .card-hover-overlay,
    .program-card:active .card-hover-overlay {
      opacity: 1;
      visibility: visible;
    }

    .hover-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .hover-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
    }

    .hover-sublist {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 0;
      padding: 0;
    }

    .hover-sublist li {
      font-family: var(--font-heading);
      font-size: 16px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
    }

    .read-more-link {
      margin-top: auto;
      font-family: var(--font-heading);
      font-size: 16px;
      font-weight: 700;
      color: #d92525;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .read-more-link:hover {
