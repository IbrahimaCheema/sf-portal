---
import Layout from '../layouts/Layout.astro';

const ceremonyPhotos = [
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_1.jpg", local: "/images/prize_ceremony_1.jpg", title: "Merit Certificate Awarding", desc: "Top student receiving merit award and cash prize." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_2.jpg", local: "/images/prize_ceremony_2.jpg", title: "Annual Prize Ceremony 2023", desc: "Distinguished guests presenting awards to high achievers." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_3.jpg", local: "/images/prize_ceremony_3.jpg", title: "Teacher Recognition", desc: "Honoring outstanding teachers for exemplary academic results." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_4.jpg", local: "/images/prize_ceremony_4.jpg", title: "Student Shield Honors", desc: "Class toppers receiving distinction trophies and stationery hampers." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_5.jpg", local: "/images/prize_ceremony_5.jpg", title: "Adopted School Campus Event", desc: "School assembly celebrating end-of-year examination results." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_6.jpg", local: "/images/prize_ceremony_6.jpg", title: "Girls Elementary School Awards", desc: "Encouraging female students towards higher educational goals." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_7.jpg", local: "/images/prize_ceremony_7.jpg", title: "Community & Parent Gathering", desc: "Parents and community elders attending the ceremony." },
  { r2: "https://docs.sf.org.pk/images/prize_ceremony_8.jpg", local: "/images/prize_ceremony_8.jpg", title: "Foundation Executive Address", desc: "Shakarganj Foundation team encouraging young scholars." }
];
---

<Layout 
  title="Prize Distribution Ceremonies – Shakarganj Foundation"
  description="Explore Shakarganj Foundation's annual prize distribution ceremonies honoring top-performing students and teachers across adopted schools."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/education/">Education</a> <span>›</span>
        <span class="current">Prize Distribution Ceremonies</span>
      </div>
      <h1 class="hero_page_title">Prize Distribution Ceremonies</h1>
      <p class="hero_subtitle">Celebrating academic excellence, honoring top-performing students, and recognizing dedicated faculty across all adopted schools.</p>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="ceremony-overview-section">
    <div class="container">
      
      <div class="overview-grid">
        <div class="overview-img-box">
          <img 
            src="https://docs.sf.org.pk/images/prize_main_header.jpg" 
            alt="Prize Distribution Main"
            loading="lazy"
            onerror="this.src='/images/prize_main_header.jpg'"
          />
        </div>
        <div class="overview-text-box">
          <span class="badge badge-accent">ANNUAL ACADEMIC HONORS</span>
          <h2 class="section-title">Encouraging Striving for Success</h2>
          <div class="title-decorator"></div>
          <p class="overview-desc">
            Shakarganj Foundation holds annual end-of-year <strong>Prize Distribution Ceremonies</strong> to honor students who have achieved top grades in their final examinations. Conducted across all 21 adopted government schools in District Jhang, these ceremonies inspire students to continuously strive for academic distinction and personal growth.
          </p>
          <div class="ceremony-features">
            <div class="feature-item">
              <span class="feature-icon">🏆</span>
              <span><strong>Merit Cash Prizes & Shields</strong> for Class Toppers</span>
            </div>
            <div class="feature-item">
              <span class="feature-icon">👩‍🏫</span>
              <span><strong>Teacher Appreciation Awards</strong> for Best Passing Ratios</span>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🎒</span>
              <span><strong>Free Books & Stationery Hampers</strong> for All Position Holders</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Gallery Section -->
  <section class="ceremony-gallery-section">
    <div class="container">
      
      <div class="section-intro">
        <span class="badge badge-primary">PHOTO GALLERY</span>
        <h2 class="section-title">Ceremony Highlights</h2>
        <div class="title-decorator"></div>
        <p class="section-subtitle">Moments of joy, pride, and achievement captured during our annual adopted school distribution ceremonies.</p>
      </div>

      <div class="grid-4 gallery-grid">
        {ceremonyPhotos.map((photo) => (
          <div class="card photo-card">
            <div class="photo-img-wrapper">
              <img 
                src={photo.r2} 
                alt={photo.title} 
                loading="lazy"
                onerror={`this.src='${photo.local}'`}
              />
              <div class="photo-overlay">
                <a href={photo.r2} target="_blank" rel="noopener noreferrer" class="zoom-btn" title="View full image">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  <span>Zoom Image</span>
                </a>
              </div>
            </div>
            <div class="photo-body">
              <h3 class="photo-title">{photo.title}</h3>
              <p class="photo-desc">{photo.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <style>
    .ceremony-overview-section {
      padding: 60px 0;
      background: var(--bg-white);
    }
    .overview-grid {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 35px;
      align-items: center;
    }
    .overview-img-box img {
      width: 200px;
      height: 200px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid var(--accent-gold);
      box-shadow: var(--shadow-md);
    }
    .overview-desc {
      font-size: 15.5px;
      line-height: 1.75;
      color: var(--text-dark);
      margin-bottom: 20px;
    }
    .ceremony-features {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .feature-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14.5px;
      color: var(--text-dark);
      background: var(--bg-light);
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--primary-color);
    }
    .feature-icon {
      font-size: 18px;
    }
    .ceremony-gallery-section {
      padding: 40px 0 80px;
      background: var(--bg-light);
    }
    .section-intro {
      text-align: center;
      margin-bottom: 45px;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .photo-card {
      background: #ffffff;
      border-top: 4px solid var(--primary-color);
      transition: var(--transition-fast);
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .photo-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-md);
      border-top-color: var(--accent-gold);
    }
    .photo-img-wrapper {
      position: relative;
      background: var(--bg-light);
      padding: 10px;
      text-align: center;
    }
    .photo-img-wrapper img {
      width: 100%;
      height: 190px;
      object-fit: contain;
      object-position: center top;
      background: #f8faf8;
      border-radius: var(--radius-sm);
      transition: transform 0.3s ease;
    }
    .photo-card:hover .photo-img-wrapper img {
      transform: scale(1.03);
    }
    .photo-overlay {
      position: absolute;
      inset: 10px;
      background: rgba(0, 77, 0, 0.75);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
      border-radius: var(--radius-sm);
    }
    .photo-card:hover .photo-overlay {
      opacity: 1;
    }
    .zoom-btn {
      background: var(--accent-gold);
      color: #000000;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 50px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }
    .photo-body {
      padding: 16px;
      flex-grow: 1;
    }
    .photo-title {
      font-size: 15.5px;
      color: var(--primary-dark);
      margin-bottom: 6px;
      font-weight: 700;
    }
    .photo-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Responsive */
    @media (max-width: 1100px) {
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 768px) {
      .overview-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .overview-img-box img {
        margin: 0 auto;
      }
    }
    @media (max-width: 500px) {
      .gallery-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
