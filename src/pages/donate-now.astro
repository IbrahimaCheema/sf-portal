---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Donate Now – Shakarganj Foundation"
  description="Support Shakarganj Foundation's education and healthcare initiatives. Bank transfer details and direct donation methods."
>
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <span class="current">Donate Now</span>
      </div>
      <h1 class="hero_page_title">Support Our Cause</h1>
      <p class="hero_subtitle">Your generous contribution directly funds free medical care, student scholarships, and child nutrition programs.</p>
    </div>
  </section>

  <section class="donate-page-section">
    <div class="container">
      <div class="grid-2">
        <!-- Direct Bank Account Card -->
        <div class="card bank-details-card">
          <div class="card-body">
            <span class="badge badge-accent">DIRECT BANK TRANSFER</span>
            <h2>Official Bank Account Details</h2>
            <p>You can make a direct bank deposit or online transfer using the official MCB Bank account below:</p>

            <div class="detail-box">
              <div class="detail-row">
                <span class="label">Bank Name:</span>
                <span class="val">MCB Bank Limited</span>
              </div>
              <div class="detail-row">
                <span class="label">Account Title:</span>
                <span class="val">Shakarganj Foundation</span>
              </div>
              <div class="detail-row highlight-acc">
                <span class="label">Account Number:</span>
                <span class="val acc-num">0124301010014225</span>
              </div>
              <div class="detail-row">
                <span class="label">Branch Code / Location:</span>
                <span class="val">MCB Jhang Branch, Pakistan</span>
              </div>
            </div>

            <div class="tax-note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>100% of your donation is dedicated to direct community welfare projects.</span>
            </div>
          </div>
        </div>

        <!-- Interactive Pledge Form -->
        <div class="card pledge-card">
          <div class="card-body">
            <span class="badge badge-primary">DONATION PLEDGE</span>
            <h2>Submit Donation Notification</h2>
            <p>After transferring your donation, please let us know so we can send an official receipt.</p>

            <form class="pledge-form" id="pledgeForm">
              <div class="form-group">
                <label for="donorName">Full Name *</label>
                <input type="text" id="donorName" required placeholder="Your full name" class="form-control" />
              </div>
              <div class="form-group">
                <label for="donorEmail">Email Address *</label>
                <input type="email" id="donorEmail" required placeholder="name@example.com" class="form-control" />
              </div>
              <div class="form-group">
                <label for="donorPhone">Phone / WhatsApp</label>
                <input type="tel" id="donorPhone" placeholder="+92 300 1234567" class="form-control" />
              </div>
              <div class="form-group">
                <label for="amount">Donation Amount (PKR) *</label>
                <input type="number" id="amount" required placeholder="e.g. 10000" class="form-control" />
              </div>
              <div class="form-group">
                <label for="cause">Select Cause</label>
                <select id="cause" class="form-control">
                  <option value="general">General Relief Fund</option>
                  <option value="education">Talib Hussain Education Scholarship</option>
                  <option value="healthcare">Subsidized Healthcare & OPD Clinics</option>
                  <option value="nutrition">SF-TMSG Fight Against Malnutrition</option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary btn-block">Submit Donation Receipt</button>
            </form>

            <div class="toast-success" id="toastSuccess">
              ✓ Thank you! Your donation pledge has been submitted. Our team will verify and send your official receipt via email.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .donate-page-section {
      padding: 70px 0;
    }
    .bank-details-card {
      border-top: 5px solid var(--accent-gold);
    }
    .pledge-card {
      border-top: 5px solid var(--primary-color);
    }
    .detail-box {
      background: var(--bg-light);
      border-radius: var(--radius-sm);
      padding: 20px;
      margin: 20px 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      border-bottom: 1px solid var(--border-light);
      padding-bottom: 8px;
    }
    .detail-row.highlight-acc {
      border-bottom: none;
      background: rgba(0, 77, 0, 0.05);
      padding: 10px;
      border-radius: var(--radius-sm);
    }
    .label { color: var(--text-muted); font-weight: 600; }
    .val { color: var(--text-dark); font-weight: 700; }
    .acc-num { font-size: 18px; color: var(--primary-color); }
    .tax-note {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--primary-dark);
      background: rgba(116, 173, 102, 0.15);
      padding: 12px 16px;
      border-radius: var(--radius-sm);
    }
    .pledge-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 20px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dark);
    }
    .form-control {
      padding: 10px 14px;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: 14px;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--primary-color);
    }
    .btn-block {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
    }
    .toast-success {
      display: none;
      margin-top: 20px;
      padding: 14px 18px;
      background: #d4edda;
      color: #155724;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 600;
    }
  </style>

  <script>
    const form = document.getElementById('pledgeForm');
    const toast = document.getElementById('toastSuccess');
    if (form && toast) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        toast.style.display = 'block';
        form.reset();
      });
    }
  </script>
</Layout>
