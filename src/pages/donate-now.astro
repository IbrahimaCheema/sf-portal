---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Donate Now – Shakarganj Foundation"
  description="Support Shakarganj Foundation's education and healthcare initiatives. Bank transfer details MCB 0124301010014225 and donation receipt pledge form."
>
  <!-- Standard Top Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <span class="current">Donate Now</span>
      </div>
      <h1 class="hero_page_title">Your Contribution Will Transform Lives</h1>
      <p class="hero_subtitle">Empowering communities through direct healthcare, student scholarships, child nutrition, and seasonal relief drives.</p>
    </div>
  </section>

  <!-- Donate Section -->
  <section class="donate-page-section">
    <div class="container">
      
      <!-- Top Message Callout -->
      <div class="donate-callout-box card text-center">
        <span class="badge badge-accent">MAKE A DIFFERENCE TODAY</span>
        <h2>Shakarganj Foundation Bank Account Details</h2>
        <p>100% of your generous contribution directly funds field operations, medical supplies, student scholarships, and food drives across District Jhang.</p>
      </div>

      <div class="grid-2">
        <!-- Direct Bank Account Card -->
        <div class="card bank-details-card">
          <div class="card-body">
            <div class="bank-card-header">
              <img 
                src="https://docs.sf.org.pk/images/mcb_logo.png" 
                alt="MCB Bank Logo" 
                class="mcb-logo"
                loading="lazy"
                onerror="this.src='/images/mcb_logo.png'"
              />
              <div>
                <span class="badge badge-primary">OFFICIAL BANK TRANSFER</span>
                <h3 class="bank-title">MCB Bank Limited</h3>
              </div>
            </div>

            <div class="detail-box">
              <div class="detail-row">
                <span class="label">Account Title:</span>
                <span class="val">Shakarganj Foundation</span>
              </div>
              <div class="detail-row highlight-acc">
                <div>
                  <span class="label">Account Number:</span>
                  <div class="acc-num" id="accNumText">0124301010014225</div>
                </div>
                <button id="copyAccBtn" class="copy-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span id="copyBtnText">Copy Account #</span>
                </button>
              </div>
              <div class="detail-row">
                <span class="label">Bank Name:</span>
                <span class="val">MCB Bank Limited</span>
              </div>
              <div class="detail-row">
                <span class="label">Branch Location:</span>
                <span class="val">MCB Jhang Branch, Pakistan</span>
              </div>
            </div>

            <div class="tax-note">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <div>
                <strong>Direct Impact Guarantee:</strong> Every rupee donated goes directly to verified community beneficiaries.
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Pledge Form -->
        <div class="card pledge-card">
          <div class="card-body">
            <span class="badge badge-accent">DONATION RECEIPT PLEDGE</span>
            <h2>Submit Donation Notification</h2>
            <p>Transferred a donation? Fill out this form so our financial team can verify and issue an official tax receipt.</p>

            <form class="pledge-form" id="pledgeForm">
              <div class="form-group">
                <label for="donorName">Full Name *</label>
                <input type="text" id="donorName" required placeholder="Enter your full name" class="form-control" />
              </div>
              <div class="form-group">
                <label for="donorEmail">Email Address *</label>
                <input type="email" id="donorEmail" required placeholder="name@example.com" class="form-control" />
              </div>
              <div class="form-group">
                <label for="donorPhone">Phone / WhatsApp Number</label>
                <input type="tel" id="donorPhone" placeholder="+92 300 1234567" class="form-control" />
              </div>
              <div class="form-group">
                <label for="amount">Donation Amount (PKR) *</label>
                <input type="number" id="amount" required placeholder="e.g. 10000" class="form-control" />
              </div>
              <div class="form-group">
                <label for="cause">Designate Cause</label>
                <select id="cause" class="form-control">
                  <option value="general">General Relief & Welfare Fund</option>
                  <option value="education">Talib Hussain Education Scholarship</option>
                  <option value="healthcare">Stationed & Mobile Free Dispensaries</option>
                  <option value="nutrition">SF-TMSG Fight Against Malnutrition</option>
                  <option value="art">Jhang Art Gallery Vocational Training</option>
                </select>
              </div>
              <div class="form-group">
                <label for="refNum">Bank Transaction Reference / Deposit Slip #</label>
                <input type="text" id="refNum" placeholder="e.g. MCB-TRX-987654" class="form-control" />
              </div>

              <button type="submit" class="btn btn-primary btn-block">Submit Donation Notification</button>
            </form>

            <div class="toast-success" id="toastSuccess">
              ✓ Thank you! Your donation notification has been submitted. Our accounting team will verify the transfer and email your official tax receipt shortly.
            </div>
          </div>
        </div>
      </div>

      <!-- Impact Tiers Section -->
      <div class="impact-tiers-section">
        <h3 class="tiers-header-title text-center">How Your Donation Transforms Lives</h3>
        <div class="tiers-grid">
          <div class="tier-card card">
            <div class="tier-amount">PKR 5,000</div>
            <h4>Scholarship & Books</h4>
            <p>Funds 1 month of tuition, books, uniform, and meals for a deserving rural student.</p>
          </div>
          <div class="tier-card card">
            <div class="tier-amount">PKR 10,000</div>
            <h4>Free Medical Care</h4>
            <p>Provides OPD checkups, sugar/hepatitis tests, and free medicines for 25 patients.</p>
          </div>
          <div class="tier-card card">
            <div class="tier-amount">PKR 25,000</div>
            <h4>Malnutrition Feeding</h4>
            <p>Supplies therapeutic nutrition paste (RUTF) & milk supplements to 10 severely malnourished children.</p>
          </div>
          <div class="tier-card card">
            <div class="tier-amount">PKR 50,000</div>
            <h4>Ramzan & Food Relief</h4>
            <p>Provides comprehensive monthly ration packages (flour, rice, oil, pulses) for 5 needy families.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <style>
    .donate-page-section {
      padding: 60px 0 80px;
      background: var(--bg-light);
    }
    .donate-callout-box {
      padding: 30px;
      margin-bottom: 35px;
      border-top: 4px solid var(--accent-gold);
      background: #ffffff;
    }
    .donate-callout-box h2 {
      font-size: 24px;
      color: var(--primary-dark);
      margin: 8px 0;
    }
    .donate-callout-box p {
      font-size: 15px;
      color: var(--text-dark);
      margin: 0 auto;
      max-width: 700px;
    }

    .bank-details-card {
      border-top: 5px solid var(--accent-gold);
      background: #ffffff;
    }
    .pledge-card {
      border-top: 5px solid var(--primary-color);
      background: #ffffff;
    }
    .bank-card-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-light);
    }
    .mcb-logo {
      height: 55px;
      width: auto;
      object-fit: contain;
    }
    .bank-title {
      font-size: 20px;
      color: var(--primary-dark);
      margin-top: 4px;
    }

    .detail-box {
      background: var(--bg-light);
      border-radius: var(--radius-sm);
      padding: 20px;
      margin: 20px 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
      border: 1px solid var(--border-light);
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14.5px;
      border-bottom: 1px dashed var(--border-light);
      padding-bottom: 10px;
    }
    .detail-row.highlight-acc {
      border-bottom: none;
      background: #ffffff;
      padding: 16px;
      border-radius: var(--radius-sm);
      border: 2px solid var(--accent-gold);
    }
    .label { color: var(--text-muted); font-weight: 600; }
    .val { color: var(--text-dark); font-weight: 700; }
    .acc-num { font-size: 22px; font-weight: 800; color: var(--primary-color); letter-spacing: 1px; margin-top: 2px; }

    .copy-btn {
      background: var(--accent-gold);
      color: #000000;
      border: none;
      padding: 8px 14px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s ease;
    }
    .copy-btn:hover {
      background: #ff9c1e;
    }

    .tax-note {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13.5px;
      color: var(--primary-dark);
      background: rgba(0, 77, 0, 0.08);
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      border-left: 4px solid var(--primary-color);
    }

    .pledge-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 18px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dark);
    }
    .form-control {
      padding: 10px 14px;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s ease;
    }
    .form-control:focus {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(0, 77, 0, 0.1);
    }
    .btn-block {
      width: 100%;
      padding: 14px;
      margin-top: 8px;
    }
    .toast-success {
      display: none;
      margin-top: 18px;
      padding: 14px 18px;
      background: #d4edda;
      color: #155724;
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      font-weight: 600;
      line-height: 1.5;
    }

    /* Impact Tiers */
    .impact-tiers-section {
      margin-top: 60px;
    }
    .tiers-header-title {
      font-size: 22px;
      color: var(--primary-dark);
      margin-bottom: 24px;
    }
    .tiers-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .tier-card {
      padding: 24px;
      background: #ffffff;
      border-top: 4px solid var(--primary-color);
      text-align: center;
      transition: var(--transition-fast);
    }
    .tier-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-top-color: var(--accent-gold);
    }
    .tier-amount {
      font-size: 22px;
      font-weight: 800;
      color: var(--accent-gold);
      margin-bottom: 8px;
    }
    .tier-card h4 {
      font-size: 16px;
      color: var(--primary-dark);
      margin-bottom: 8px;
    }
    .tier-card p {
      font-size: 13px;
      line-height: 1.55;
      color: var(--text-muted);
      margin: 0;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .tiers-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .tiers-grid {
        grid-template-columns: 1fr;
      }
      .detail-row.highlight-acc {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Copy Account Number
      const copyAccBtn = document.getElementById('copyAccBtn');
      const copyBtnText = document.getElementById('copyBtnText');
      const accNumText = document.getElementById('accNumText');

      if (copyAccBtn && accNumText) {
        copyAccBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(accNumText.textContent.trim());
          copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            copyBtnText.textContent = 'Copy Account #';
          }, 2500);
        });
      }

      // Pledge Form Submission
      const form = document.getElementById('pledgeForm');
      const toast = document.getElementById('toastSuccess');
      if (form && toast) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          toast.style.display = 'block';
          form.reset();
        });
      }
    });
  </script>
</Layout>
