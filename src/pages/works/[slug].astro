---
import Layout from '../../layouts/Layout.astro';
import worksData from '../../data/worksArticles.json';

export function getStaticPaths() {
  const publicationsMeta = [
    {
      slug: "service-above-self",
      category: "Community Welfare",
      author: "Muhammad Saifullah",
      role: "Chairman (Social Action Projects Committee)",
      qualifications: "BSc (Electrical Engineering) & EMBA",
      date: "July 3rd, 2026",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-1.jpg"
    },
    {
      slug: "drug-addiction-among-youth-a-growing-challenge-in-our-community",
      category: "Public Health",
      author: "Dr. Shahid Hussain",
      role: "Vice Chairman (Social Action Projects Committee)",
      qualifications: "PhD (Chemistry)",
      date: "June 30th, 2026",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-2.jpg"
    },
    {
      slug: "building-hope-enriching-lives",
      category: "Community Welfare",
      author: "Muhammad Pervez Akhtar",
      role: "SEVP",
      qualifications: "MSc Chemistry",
      date: "June 30th, 2026",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-3.jpg"
    },
    {
      slug: "diabetes-its-impact-on-our-life-and-its-management",
      category: "Public Health",
      author: "Dr. Muhammad Aamir",
      role: "Manager (Public Health)",
      qualifications: "MD (MBBS) RU. C/A DTCD (PK)",
      date: "June 29th, 2026",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-4.jpg"
    },
    {
      slug: "the-most-powerful-weapon-to-change-the-world",
      category: "Education",
      author: "Samra Ashraf",
      role: "Manager (Shakarganj Foundation)",
      qualifications: "MSc Psychology, MS Management (BPP University London)",
      date: "June 29th, 2026",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-5.jpg"
    },
    {
      slug: "from-learning-to-livelihood-how-skills-transform-communities",
      category: "Vocational Skills",
      author: "Muhammad Hussain Malik",
      role: "GM (HR-Admin)",
      qualifications: "LLB",
      date: "June 12th, 2026",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-6.png"
    },
    {
      slug: "a-long-road-ahead-the-struggle-for-gender-equality",
      category: "Social Empowerment",
      author: "Mustapha Altaf Saleem",
      role: "Member (Social Action Projects Committee)",
      qualifications: "MBA",
      date: "July 31st, 2025",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-7.png"
    },
    {
      slug: "importance-of-cultural-competence-in-social-work",
      category: "Social Empowerment",
      author: "Muhammad Hussain Malik",
      role: "GM (HR-Admin)",
      qualifications: "LLB",
      date: "February 7th, 2025",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-8.png"
    },
    {
      slug: "article-8",
      category: "Environmental Health",
      author: "Dr. Shahid Hussain",
      role: "Vice Chairman (Social Action Projects Committee)",
      qualifications: "PhD (Chemistry)",
      date: "January 27th, 2025",
