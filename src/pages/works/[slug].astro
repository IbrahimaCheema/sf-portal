      date: "September 25th, 2023",
      coverImg: "https://docs.sf.org.pk/images/publications/pub-16.jpg"
    }
  ];

  return publicationsMeta.map(meta => {
    const fullArticle = worksData.find(w => w.slug === meta.slug) || {};
    return {
      params: { slug: meta.slug },
      props: { meta, fullArticle }
    };
  });
}

const { meta, fullArticle } = Astro.props;
const title = fullArticle.title || meta.slug.replace(/-/g, ' ').toUpperCase();
---

<Layout 
  title={`${title} – Shakarganj Foundation Publications`}
  description={`Read full publication: ${title} by ${meta.author}. Published by Shakarganj Foundation.`}
>
  <!-- Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <span>›</span>
        <a href="/publications">Publications</a> <span>›</span>
        <span class="current">{title}</span>
      </div>
      <h1 class="hero_page_title">{title}</h1>
      <p class="hero_subtitle">By {meta.author} • {meta.role} ({meta.date})</p>
    </div>
  </section>

  <!-- Main Article Section -->
  <section class="article-details-section">
    <div class="container">
      <div class="article-layout">
        
        <!-- Main Content Left Column -->
        <main class="article-main-content">
          <div class="top-nav-bar">
            <a href="/publications" class="back-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              <span>Back to All Publications</span>
            </a>
            <span class="badge badge-accent">{meta.category}</span>
          </div>

          <div class="author-card card">
            <div class="author-info-box">
              <div class="author-avatar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div>
                <h3 class="author-name-text">Author: {meta.author}</h3>
                <p class="author-role-text">{meta.role}</p>
                {meta.qualifications && <p class="author-qual-text">{meta.qualifications}</p>}
                <p class="pub-date-text">Published on {meta.date}</p>
              </div>
            </div>
          </div>

          <div class="article-cover-box card text-center">
            <img 
              src={meta.coverImg} 
              alt={title} 
              class="article-cover-img"
              loading="eager"
            />
          </div>

          <div class="article-body card">
            {fullArticle.bodyHtml ? (
              <div class="wp-content-render" set:html={fullArticle.bodyHtml} />
            ) : (
              <div class="article-fallback-body">
                <h3>Publication Summary</h3>
                <p>This empirical research paper highlights Shakarganj Foundation's field initiatives in {meta.category.toLowerCase()} across District Jhang.</p>
              </div>
            )}
          </div>
        </main>

        <!-- Sidebar Right Column -->
        <aside class="article-sidebar">
          <div class="card sidebar-box text-center">
            <span class="badge badge-primary">SHAKARGANJ FOUNDATION</span>
            <h3>Support Our Cause</h3>
            <p>Your contribution directly funds education scholarships, medical care, and community development.</p>
            <a href="/donate-now" class="btn btn-primary btn-block" style="margin-top: 15px;">Donate Now</a>
          </div>

          <div class="card sidebar-box">
            <h4>Quick Navigation</h4>
            <ul class="sidebar-links">
              <li><a href="/publications">All Publications</a></li>
              <li><a href="/education">Education Initiatives</a></li>
              <li><a href="/healthcare">Healthcare Services</a></li>
              <li><a href="/campaigns">Active Campaigns</a></li>
              <li><a href="/whyeducation">Why Education</a></li>
            </ul>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <style>
    .article-details-section {
      padding: 60px 0 90px;
      background: var(--bg-light);
    }
    .article-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 35px;
    }
    .top-nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .back-link {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--primary-color);
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      transition: color 0.2s ease;
    }
    .back-link:hover {
      color: var(--accent-gold);
    }

    .author-card {
      padding: 20px 24px;
      margin-bottom: 25px;
      border-left: 5px solid var(--accent-gold);
      background: #ffffff;
    }
    .author-info-box {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .author-avatar-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: var(--bg-light);
      color: var(--primary-color);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-light);
      flex-shrink: 0;
    }
    .author-name-text {
      font-size: 18px;
      color: var(--primary-dark);
      margin: 0 0 2px;
    }
    .author-role-text {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text-dark);
      margin: 0;
    }
    .author-qual-text {
      font-size: 12.5px;
      color: var(--text-muted);
      margin: 2px 0 0;
    }
    .pub-date-text {
      font-size: 12px;
      color: var(--accent-gold);
      font-weight: 700;
      margin: 4px 0 0;
    }

    .article-cover-box {
      padding: 20px;
      background: #ffffff;
      margin-bottom: 25px;
      border-top: 4px solid var(--primary-color);
    }
    .article-cover-img {
      max-width: 100%;
      max-height: 420px;
      object-fit: contain;
      border-radius: var(--radius-sm);
    }

    .article-body {
      padding: 35px;
      background: #ffffff;
      line-height: 1.8;
      font-size: 16px;
      color: var(--text-dark);
    }
    .wp-content-render h1, .wp-content-render h2, .wp-content-render h3, .wp-content-render h4 {
      color: var(--primary-dark);
      margin-top: 1.5em;
      margin-bottom: 0.6em;
      line-height: 1.35;
    }
    .wp-content-render p {
      margin-bottom: 1.5em;
    }
    .wp-content-render img {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      margin: 20px 0;
    }

    /* Sidebar */
    .sidebar-box {
      padding: 25px;
      background: #ffffff;
      margin-bottom: 25px;
      border-top: 4px solid var(--primary-color);
    }
    .sidebar-box h3, .sidebar-box h4 {
      color: var(--primary-dark);
      margin-bottom: 12px;
      font-size: 17px;
    }
    .sidebar-box p {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.55;
    }
    .sidebar-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .sidebar-links a {
      color: var(--text-dark);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      display: block;
      padding: 8px 12px;
      background: var(--bg-light);
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
    }
    .sidebar-links a:hover {
      background: var(--primary-color);
      color: #ffffff;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .article-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
