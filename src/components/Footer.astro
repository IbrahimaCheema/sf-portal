          <a href="https://www.linkedin.com/company/shakarganj-foundation" target="_blank" aria-label="LinkedIn">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col">
        <h4 class="col-heading">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/about-us">About Us</a></li>
          <li><a href="/mission-vision">Mission & Vision</a></li>
          <li><a href="/founder">Our Founder</a></li>
          <li><a href="/board-of-governors">Board of Governors</a></li>
          <li><a href="/success-stories">Success Stories</a></li>
          <li><a href="/financials">Financials & Reports</a></li>
        </ul>
      </div>

      <!-- Column 3: Key Programs -->
      <div class="footer-col">
        <h4 class="col-heading">Our Programs</h4>
        <ul class="footer-links">
          <li><a href="/education">Educational Support</a></li>
          <li><a href="/education-scholarship">Talib Hussain Scholarship</a></li>
          <li><a href="/healthcare">Community Healthcare</a></li>
          <li><a href="/sf-tmsg-fight-against-malnutrition">Nutrition & Child Care</a></li>
          <li><a href="/jhang-art-gallery">Jhang Art Gallery</a></li>
          <li><a href="/donate-now">Support & Donate</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Donation -->
      <div class="footer-col contact-col">
        <h4 class="col-heading">Contact & Bank Info</h4>
        <p class="contact-line">
          <strong>Address:</strong> Shakarganj Foundation, Jhang, Punjab, Pakistan
        </p>
        <p class="contact-line">
          <strong>Phone:</strong> +92 47 763 1001
        </p>
        <p class="contact-line">
          <strong>Email:</strong> <a href="mailto:info@sf.org.pk">info@sf.org.pk</a>
        </p>
        <div class="bank-card">
          <span class="bank-title">💳 MCB Bank Account</span>
          <span class="bank-acc">0124301010014225</span>
          <span class="bank-sub">Shakarganj Foundation</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Shakarganj Foundation. All Rights Reserved.</p>
      <div class="bottom-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <span>•</span>
        <a href="/terms-of-service">Terms of Service</a>
        <span>•</span>
        <a href="/contact-us">Contact Us</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, #002b00 0%, #001a00 100%);
    color: #e0ece0;
    padding-top: 60px;
    padding-bottom: 25px;
    margin-top: auto;
    border-top: 4px solid var(--accent-gold);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
    gap: 40px;
    margin-bottom: 45px;
  }

  .footer-logo {
    height: 55px;
    width: auto;
    margin-bottom: 16px;
    filter: brightness(0) invert(1);
  }

  .footer-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #b0cbb0;
    margin-bottom: 20px;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    transition: var(--transition-fast);
  }

  .footer-socials a:hover {
    background: var(--accent-gold);
    color: #000000;
    transform: translateY(-3px);
  }

  .col-heading {
    font-size: 17px;
    color: #ffffff;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 10px;
  }

  .col-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 35px;
    height: 3px;
    background: var(--accent-gold);
    border-radius: 2px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #c0d8c0;
    font-size: 14px;
    transition: var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-gold);
    padding-left: 5px;
  }

  .contact-line {
    font-size: 14px;
    color: #c0d8c0;
    margin-bottom: 10px;

  .contact-line a {
    color: #ffffff;
  }

  .bank-card {
    background: rgba(255, 255, 255, 0.07);
    border-left: 3px solid var(--accent-gold);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    margin-top: 15px;
    display: flex;
    flex-direction: column;
  }

  .bank-title {
    font-size: 12px;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .bank-acc {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin: 4px 0 2px;
  }

  .bank-sub {
    font-size: 12px;
    color: #a0c4a0;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #a0c4a0;
    flex-wrap: wrap;
    gap: 15px;
  }

  .bottom-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .bottom-links a {
    color: #a0c4a0;
  }

  .bottom-links a:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
