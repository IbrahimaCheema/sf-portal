---
// Footer Component for Shakarganj Foundation
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Column 1: About -->
      <div class="footer-col brand-col">
        <img 
          src="https://docs.sf.org.pk/images/sf_logo_bg.png" 
          alt="Shakarganj Foundation Logo" 
          class="footer-logo"
          onerror="this.src='/images/sf_logo_bg.png'"
        />
