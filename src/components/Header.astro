        <li><a href="/" class="nav-link">Home</a></li>
        
        <li class="has-dropdown">
          <a href="/about-us" class="nav-link">About Us <span class="arrow">▾</span></a>
          <ul class="dropdown-menu">
            <li><a href="/about-us">Introduction</a></li>
