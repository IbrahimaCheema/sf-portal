const defaultPosts = rawDefaultPosts.map((item, idx) => parseInstagramPostInput(item, item.featureImage, item.caption, item.date));

// Automated Instagram Graph API fetch if token is present in .env
let autoPosts: PostItem[] = [];
const igToken = import.meta.env.PUBLIC_INSTAGRAM_TOKEN || import.meta.env.INSTAGRAM_ACCESS_TOKEN;

if (igToken) {
  try {
    const res = await fetch(`https://graph.instagram.com/me/media?fields=id,caption,media_type,media_url,permalink,timestamp,thumbnail_url&access_token=${igToken}&limit=${limit}`);
    if (res.ok) {
      const json = await res.json();
      if (json && json.data && json.data.length > 0) {
        autoPosts = json.data.map((item: any) => {
          let dateStr = new Date(item.timestamp || Date.now()).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
          let captionText = item.caption || "Shakarganj Foundation Post";
          
          const dateMatch = captionText.match(/^([0-9]{1,2}(?:st|nd|rd|th)?\s+[A-Za-z]+\s+[0-9]{4}|[A-Za-z]+\s+[0-9]{1,2}(?:st|nd|rd|th)?,?\s+[0-9]{4})\s*:\s*(.*)/i);
          if (dateMatch) {
            dateStr = dateMatch[1].trim();
            captionText = dateMatch[2].trim();
          }

          return {
            url: item.permalink || instagramProfileUrl,
            featureImage: item.media_url || item.thumbnail_url || "/images/hd_ig_post_1.jpg",
            caption: captionText,
            date: dateStr
          };
        });
      }
    }
  } catch (err) {
    // Fail safe to fallback posts
  }
}

const postsToDisplay = (customPosts && customPosts.length > 0) 
  ? customPosts.map((item, idx) => parseInstagramPostInput(item, `/images/hd_ig_post_${(idx % 4) + 1}.jpg`, "Shakarganj Foundation Activity", "28 July, 2026"))
  : (autoPosts.length > 0 ? autoPosts : defaultPosts);
