// ActivitiesEvents.astro - Social Media Feed directly linked to Instagram (@shakarganjfoundation)
export interface PostItem {
  url?: string;
  embedCode?: string;
  featureImage?: string;
  caption?: string;
  date?: string;
}

export interface Props {
  instagramHandle?: string;
  limit?: number;
  customPosts?: (PostItem | string)[];
}

const { 
  instagramHandle = "shakarganjfoundation",
  limit = 4,
  customPosts
} = Astro.props;

const instagramProfileUrl = `https://www.instagram.com/${instagramHandle}/`;

// Parser helper for Instagram post URLs or Instagram embed HTML blockquotes
function parseInstagramPostInput(input: PostItem | string, fallbackImage: string, fallbackCaption: string, fallbackDate: string): PostItem {
  const rawStr = typeof input === 'string' ? input : (input.embedCode || input.url || '');
  
  // Extract permalink from data-instgrm-permalink or href
  const permalinkMatch = rawStr.match(/data-instgrm-permalink=["']([^"']+)["']/i) || rawStr.match(/href=["'](https?:\/\/(?:www\.)?instagram\.com\/p\/[^"'\s]+)["']/i);
  const cleanUrl = permalinkMatch ? permalinkMatch[1].replace(/&amp;/g, '&') : (rawStr.startsWith('http') ? rawStr : instagramProfileUrl);

  const img = (typeof input === 'object' && input.featureImage) ? input.featureImage : fallbackImage;
  const cap = (typeof input === 'object' && input.caption) ? input.caption : fallbackCaption;
  const dt = (typeof input === 'object' && input.date) ? input.date : fallbackDate;

  return {
    url: cleanUrl,
    featureImage: img,
    caption: cap,
    date: dt
  };
}

