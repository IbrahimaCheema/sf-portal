    text-decoration: none;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.3s ease;
    cursor: pointer;
  }

  .event-card:hover {
    transform: translateY(-6px);
  }

  /* Card Image & Aspect Ratio - 1:1 Square (100% Full Uncropped Instagram Post Display) */
  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 1:1 square aspect ratio matching native Instagram post scaling */
    overflow: hidden;
    background-color: #f8f9fa;
    border-radius: 6px 6px 0 0;
  }

  .card-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
    border-radius: 6px 6px 0 0;
    transition: transform 0.4s ease;
  }

  .event-card:hover .card-img {
    transform: scale(1.05);
  }

  /* Instagram Hover Badge */
  .ig-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    padding: 6px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .event-card:hover .ig-badge {
    opacity: 1;
    background: #e1306c;
    transform: scale(1.1);
  }

  /* Red indicator bar under image */
