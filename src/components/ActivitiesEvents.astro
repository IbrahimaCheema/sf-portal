<section class="activities-events-section" id="activities-events">
  <div class="container">
    <!-- Header Title matching exact attached reference style -->
    <div class="section-header">
      <h2 class="section-title">Activities & Events</h2>
      <div class="red-bar-accent"></div>
    </div>

    <!-- 4 Posts Grid -->
    <div class="events-grid" id="instagramFeedGrid">
      {postsToDisplay.slice(0, limit).map((post, index) => (
        <a 
          href={post.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="event-card"
          data-post-index={index}
          data-post-url={post.url}
          aria-label={`View Instagram post: ${post.caption}`}
        >
          <div class="card-image-wrapper">
            <img 
              src={post.featureImage} 
              alt={post.caption} 
              class="card-img" 
              loading="lazy"
              id={`ig-img-${index}`}
            />
            <div class="ig-badge" title="View Post on Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
          </div>

          <!-- Red Line Indicator beneath image -->
          <div class="card-red-indicator"></div>

          <!-- Post Description / Caption -->
          <h3 class="card-title" id={`ig-caption-${index}`}>{post.caption}</h3>

          <!-- Post Timestamp with Red Clock Icon -->
          <div class="card-meta">
            <svg class="clock-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="meta-date" id={`ig-date-${index}`}>{post.date}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- View All Button on Homepage -->
    {limit && limit <= 4 && (
      <div class="view-all-wrapper">
        <a href="/activities-events" class="btn-view-all">
          View All Activities & Events
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<!-- On-Page-Load Live Post URL / Embed Scraper Hydration Script -->
<script>
  // Dynamic client-side Instagram Post URL & Embed scraper
  async function scrapeAndHydratePost(cardEl: HTMLElement, index: number) {
    const postUrl = cardEl.getAttribute('data-post-url');
    if (!postUrl || !postUrl.includes('/p/')) return;

    try {
      // Use CORS proxy to extract OpenGraph tags (og:image, og:description, og:title) dynamically from post URL or embed link
      const proxyUrl = `https://corsproxy.io/?${encodeURIComponent(postUrl)}`;
      const res = await fetch(proxyUrl);
      if (res.ok) {
        const html = await res.text();
        const ogDescMatch = html.match(/property="og:description"\s+content="([^"]+)"/i) || html.match(/content="([^"]+)"\s+property="og:description"/i);

        if (ogDescMatch && ogDescMatch[1]) {
          const rawDesc = ogDescMatch[1].replace(/&quot;/g, '"').replace(/&#039;/g, "'").replace(/&amp;/g, '&');
          const parsed = rawDesc.match(/on ([^:]+):\s*"(.*)"/) || rawDesc.match(/on ([^:]+):\s*(.*)/);
          const captionEl = document.getElementById(`ig-caption-${index}`);
          const dateEl = document.getElementById(`ig-date-${index}`);

          if (parsed) {
            let extractedDate = parsed[1].trim();
            let fullText = parsed[2].replace(/^"/, '').replace(/"$/, '').trim();

            // Extract date prefix if description starts with a date like "27th July 2026: Summer Calligraphy..."
            const datePrefixMatch = fullText.match(/^([0-9]{1,2}(?:st|nd|rd|th)?\s+[A-Za-z]+\s+[0-9]{4}|[A-Za-z]+\s+[0-9]{1,2}(?:st|nd|rd|th)?,?\s+[0-9]{4})\s*:\s*(.*)/i);
            if (datePrefixMatch) {
              extractedDate = datePrefixMatch[1].trim();
              fullText = datePrefixMatch[2].trim();
            }

            if (dateEl) dateEl.textContent = extractedDate;
            if (captionEl) captionEl.textContent = fullText;
          }
        }
      }
    } catch (err) {
      // Silent fallback
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.event-card');
    cards.forEach((card, index) => {
      scrapeAndHydratePost(card as HTMLElement, index);
    });
  });
</script>

